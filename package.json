{
  "name": "bluepex-vpn",
  "productName": "BluePexVPN",
  "version": "0.1.2",
  "description": "BluePex VPN Client with Azure AD authentication and 2FA support",
  "main": "main.js",
  "author": {
    "name": "BluePex",
    "email": "contato@bluepex.com"
  },
  "homepage": "https://bluepex.com",
  "scripts": {
    "start": "electron . --no-sandbox --disable-gpu",
    "dev": "electron . --dev --no-sandbox --disable-gpu",
    "clean": "rm -f app_state.json default_profiles.json user_profiles.json azure_profiles.json",
    "reset": "npm run clean && npm start",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --linux --win",
    "release": "npm run build:all && electron-builder --publish=always",
    "release:linux": "npm run build:linux && electron-builder --publish=always",
    "release:win": "npm run build:win && electron-builder --publish=always",
    "logs": "node scripts/view-logs.js",
    "logs:renderer": "node scripts/view-logs.js --filter renderer",
    "logs:tail": "tail -f /var/log/bluepex-vpn/logs/*.log 2>/dev/null || tail -f ~/.config/bluepex-vpn/logs/*.log",
    "test": "node scripts/test-logging.js && node scripts/test-modal-classes.js && node scripts/test-ui-functions.js"
  },
  "dependencies": {
    "@azure/msal-node": "^2.0.0",
    "axios": "^1.6.0",
    "electron-updater": "^6.6.2",
    "ps-node": "^0.1.6"
  },
  "devDependencies": {
    "electron": "^39.2.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.bluepex.vpn",
    "productName": "BluePex VPN",
    "copyright": "Copyright © 2025 BluePex",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "mvclaudianobj",
      "repo": "BluePexVPN",
      "private": false
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "config.json",
      "logo.png",
      "ovpn_profiles/**/*",
      "build/com.bpvpn.pkexec.policy",
      "icon-azure.png",
      "icon-close.png",
      "icon-config.png",
      "icon-download.png",
      "icon-key-settings.png",
      "icon-key.png",
      "icon-log-system.png",
      "icon-logs.png",
      "icon-minimize.png",
      "icon-password.png",
      "icon-update.png",
      "icon-user.png",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "build/com.bpvpn.pkexec.policy",
        "to": "com.bpvpn.pkexec.policy"
      },
      {
        "from": "logo.png",
        "to": "app/logo.png"
      },
      {
        "from": "splash.html",
        "to": "app/splash.html"
      },
       {
        "from": "build/icon.png",
        "to": "app/icon.png"
       },
        {
        "from": "build/icon.ico",
        "to": "app/icon.ico"
       },
       {
        "from": "icon-azure.png",
        "to": "app/icon-azure.png"
       },
       {
        "from": "icon-close.png",
        "to": "app/icon-close.png"
       },
       {
        "from": "icon-config.png",
        "to": "app/icon-config.png"
       },
       {
        "from": "icon-download.png",
        "to": "app/icon-download.png"
       },
       {
        "from": "icon-key-settings.png",
        "to": "app/icon-key-settings.png"
       },
       {
        "from": "icon-key.png",
        "to": "app/icon-key.png"
       },
       {
        "from": "icon-log-system.png",
        "to": "app/icon-log-system.png"
       },
       {
        "from": "icon-logs.png",
        "to": "app/icon-logs.png"
       },
       {
        "from": "icon-minimize.png",
        "to": "app/icon-minimize.png"
       },
       {
        "from": "icon-password.png",
        "to": "app/icon-password.png"
       },
       {
        "from": "icon-update.png",
        "to": "app/icon-update.png"
       },
       {
        "from": "icon-user.png",
        "to": "app/icon-user.png"
       },
       {
        "from": "build/OpenVPN-2.7_rc2-I009-amd64.msi",
        "to": "OpenVPN-2.7_rc2-I009-amd64.msi"
       }
    ],
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "executableArgs": [
        "--no-sandbox"
      ],
      "maintainer": "BluePex <contato@bluepex.com>",
      "vendor": "BluePex",
      "synopsis": "BluePex VPN Client with Azure AD authentication",
      "description": "BluePex VPN - Professional OpenVPN client with Azure AD authentication and 2FA support",
      "desktop": {
        "Name": "BluePex VPN",
        "Comment": "BluePex VPN Client with Azure AD authentication",
        "Categories": "Network;Security;",
        "Icon": "icon"
      }
    },
    "deb": {
      "depends": [
        "openvpn",
        "policykit-1"
      ],
      "priority": "optional",
      "maintainer": "BluePex <contato@bluepex.com>",
      "afterInstall": "build/afterInstall.sh",
      "afterRemove": "build/afterRemove.sh"
    },
    "rpm": {
      "depends": [
        "openvpn",
        "polkit"
      ],
      "vendor": "BluePex",
      "afterInstall": "build/afterInstall.sh",
      "afterRemove": "build/afterRemove.sh",
      "fpm": [
        "--rpm-tag",
        "License: MIT"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "BluePex.VPN.Setup.${version}.${ext}",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "win": {
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BluePex VPN",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    }
  },
  "keywords": [
    "vpn",
    "openvpn",
    "azure",
    "2fa",
    "security"
  ],
  "license": "MIT"
}
