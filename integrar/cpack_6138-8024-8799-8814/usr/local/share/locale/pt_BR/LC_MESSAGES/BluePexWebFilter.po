#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:181
#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:243
msgid "Overall bandwidth throttling"
msgstr "Optimizador de banda geral"

#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:182
#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:250
msgid "Per-host throttling"
msgstr "Otimização por host"

#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:183
msgid "Load Balance"
msgstr "Balanceamento de links"

#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:200
msgid "Edit Traffic Management"
msgstr "Editar Gerenciamento de trafego"

#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:205
msgid "Remove Traffic Management"
msgstr "Remover Gerenciamento de trafego"

#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:225
#, php-format
msgid "Traffic Managment Settings (%s)"
msgstr "Configurações de gerenciamento de trafego (%s)"

#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:229
msgid "Maximum download size"
msgstr "Tamanho maximo de download"

#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:232
msgid ""
"Limit the maximum total download size to the size specified here (in "
"kilobytes). Set to 0 to disable."
msgstr ""
"Limita o tamanho maximo de download para o tamanho definido aqui (em "
"kilobytes). Sete 0 para desabilitar."

#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:236
msgid "Maximum upload size"
msgstr "Tamanho maximo de upload"

#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:239
msgid ""
"Limit the maximum total upload size to the size specified here (in "
"kilobytes). Set to 0 to disable."
msgstr ""
"Limita o tamanho maximo de upload definido aqui (em kilobytes). Sete 0 para "
"desabilitar."

#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:246
msgid ""
"This value specifies (in kilobytes per second) the bandwidth throttle for "
"downloads. Users will gradually have their download speed increased "
"according to this value. Set to 0 to disable bandwidth throttling."
msgstr ""
"Esse valor especifica em kbps a otimização de banda para downloads. Usuarios "
"irão ter seus downloads aumentados de acordo com esse valor. Sete 0 para "
"desabilitar."

#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:253
msgid ""
"This value specifies the download throttling per host. Set to 0 to disable "
"this."
msgstr ""
"Esse valor especifica a otimização de download por host. Sete 0 para "
"desabilitar."

#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:257
msgid "Transfer Extension Settings"
msgstr "Configurações de transferencia de extenções"

#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:261
msgid "Throttle only specific extensions"
msgstr "Otimize apenas extensões especificas"

#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:262
msgid ""
"Leave this checked to be able to choose the extensions that throttling will "
"be applied to. Otherwise, all files will be throttled."
msgstr ""
"Deixe esse campo marcado para habilitar a escolha das extenções que serão "
"limitadas. Ao contrario todas as extensões serão limitadas."

#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:269
msgid "Throttle binary files"
msgstr "Otimize arquivos binarios"

#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:270
msgid ""
"Check this to apply bandwidth throttle to binary files. This includes "
