msgstr "Gerenciamento de trafego"

#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:179
msgid "Max Download Size"
msgstr "Tamanho maximo de download"

#: files/usr/local/www/webfilter/wf_traffic_mgmt.php:180
