#: files/usr/local/pkg/squid.inc:648
msgid ""
"Only english letters, numbers and underscore are valid characters for the "
"instance name!"
msgstr ""
"Apenas letras, numeros e underscore são validos para nomes de instancias!"

#: files/usr/local/pkg/squid.inc:659
msgid ""
"You must select at least one interface under 'Proxy Interface(s)' to enable "
"Squid proxy."
msgstr ""
"Deve selecionar ao menos uma interface em 'Interfaces do proxy' para "
"habilitar o WebFilter."

#: files/usr/local/pkg/squid.inc:660
msgid ""
"If you intend to use Squid as reverse proxy ONLY, then visit Services: Squid "
"Proxy Server: General, configure and save the reverse proxy settings first."
msgstr ""
"Se quiser usar o proxy reverso APENAS, então visite Serviços: WF Server: "
"Geral, configure e salve as configurações de proxy reverso antes."

#: files/usr/local/pkg/squid.inc:663
msgid ""
"[squid] Enabled as reverse proxy ONLY. If this is not what you intended, "
"visit Services: Squid Proxy Server: General and configure proxy interfaces."
msgstr ""
"[squid] Habilitar como proxy reverso APENAS. Se essa não é sua intenção, "
"visite Serviços: WF Server: Configurações gerais e configure as interfaces "
"para o prosy."

#: files/usr/local/pkg/squid.inc:669
msgid "You must enter a valid port number in the 'ICP port' field"
msgstr "Deve entrar com um numero de porta valido no campo 'Porta ICP'"

#: files/usr/local/pkg/squid.inc:681
msgid "You can not run squid on the same port as the webgui"
msgstr "Não pode rodar o proxy na mesma porta que o painel"

#: files/usr/local/pkg/squid.inc:686
msgid "SSL interception cannot be enabled without a CA."
msgstr "Interceptação SSL não pode ser habilitada sem CA."

#: files/usr/local/pkg/squid.inc:689
msgid ""
"You must select at least one interface under 'SSL Intercept Interface(s)' "
"when 'HTTPS/SSL Interception' is enabled."
msgstr ""
"Deve selecionar ao menos uma interface em 'Interfaces para interceptar SSL' "
"quando Interceptação SSL estiver habilitada."

#: files/usr/local/pkg/squid.inc:724
msgid "You must enter a valid IP address in the 'Alternate DNS servers' field"
msgstr ""
"Deve entrar com um endereço IP valido no campo 'Servidores DNS Alternativos.'"

#: files/usr/local/pkg/squid.inc:735
msgid "The field 'Hostname' is required"
msgstr "O campo 'Nome de host' é requerido"

#: files/usr/local/pkg/squid.inc:738
msgid ""
"You must enter a valid IP address or host name in the 'Proxy hostname' field"
msgstr ""
"Deve entrar com um endereço IP valido ou nome de host no campo 'Nome de host "
"do prxy'"

#: files/usr/local/pkg/squid.inc:768
msgid "You must enter a valid value for 'Minimum object size'"
msgstr "Deve entrar com um valor para 'Tamanho minimo de objeto'"

#: files/usr/local/pkg/squid.inc:773
msgid "You must enter a valid value for 'Low-water-mark'"
msgstr "Deve entrar com um valor para 'Baixa marca d'agua'"

#: files/usr/local/pkg/squid.inc:779
msgid "You must enter a valid value for 'High-water-mark'"
msgstr "Deve entrar com um valor para 'Marca d'agua'"

#: files/usr/local/pkg/squid.inc:835
msgid "You must enter a valid IP address in the 'External Cache Manager' field"
msgstr ""
"Deve entrar com um endereço IP valido no campo 'Gerenciador de cache "
"externo.'"

#: files/usr/local/pkg/squid.inc:858
msgid "The field 'Finish when remaining KB' must contain a positive number"
msgstr "Campo 'terminar quando restar KB' deve conter um valor positivo"

#: files/usr/local/pkg/squid.inc:864
msgid "The field 'Abort when remaining KB' must contain a positive number"
msgstr "O campo 'Abortar quando restar KB' deve conter um numero positivo"

#: files/usr/local/pkg/squid.inc:870
msgid "The field 'Finish when remaining %' must contain a percentage"
msgstr "Campo 'terminar quando restar %' deve conter uma porcentagem"

#: files/usr/local/pkg/squid.inc:891
msgid "The field 'Authentication server' is required"
msgstr "O campo 'Servidor de autenticação' é requerido"

#: files/usr/local/pkg/squid.inc:893
msgid ""
"The field 'Authentication server' must contain a valid IP address or domain "
"name"
msgstr ""
"Campo 'servidor de autenticação' deve conter um endereço IP valido ou nome "
"de dominio"

#: files/usr/local/pkg/squid.inc:897
msgid "The field 'Authentication server port' must contain a valid port number"
msgstr ""
"O campo 'Porta de autenticação de servidor' deve conter um numero de porta "
"valido"

#: files/usr/local/pkg/squid.inc:903
msgid "The field 'LDAP server user DN' is required"
msgstr "O campo 'Servidor de usuario DN LDAP' é requerido"

