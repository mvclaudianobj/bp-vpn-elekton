#: files/usr/local/www/webfilter/wf_whitelist_blacklist.php:69
msgid "Black list does not accept meta characters such as * ^ & + $ % # @ [ ] ( ) { } nor domains that do not have HTTP/HTTPS in their composition;"
msgstr "Lista negra não aceita meta caracteres como * ^ & + $ % # @ [ ] ( ) { } e nem domínios que não possuam HTTP/HTTPS em sua composição;"

#: files/usr/local/www/webfilter/wf_whitelist_blacklist.php:56
msgid "Permissive list only accepts meta characters like * ^ & + $ % # @ [ ] ( ) { } and not domains that do not have HTTP/HTTPS in their composition;"
msgstr "Lista permissiva apenas aceita meta caracteres como * ^ & + $ % # @ [ ] ( ) { } e nem domínios que não possuam HTTP/HTTPS em sua composição;"

#: files/usr/local/www/webfilter/wf_whitelist_blacklist.php:69
msgid "Restrictive list does not accept meta characters such as * ^ & + $ % # @ [ ] ( ) { } nor domains that do not have HTTP/HTTPS in their composition;"
msgstr "Lista restritiva não aceita meta caracteres como * ^ & + $ % # @ [ ] ( ) { } e nem domínios que não possuam HTTP/HTTPS em sua composição;"

